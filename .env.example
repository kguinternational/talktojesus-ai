# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Twilio Configuration (Optional - for SMS and Voice features)
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Zoom Configuration (Optional - for Zoom meeting creation)
# ZOOM_API_KEY=your_zoom_api_key
# ZOOM_API_SECRET=your_zoom_api_secret

# Google Meet Configuration (Optional - for Google Meet creation)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Model Configuration (Optional - for AI response generation)
# OPENAI_API_KEY=your_openai_api_key
# AI_MODEL=gpt-4
